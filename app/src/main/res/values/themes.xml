<resources>
    <style name="Base.Theme.Pokatop" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pk_navy</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/pk_mint</item>
        <item name="colorOnSecondary">@color/pk_on_mint</item>
        <item name="android:colorBackground">@color/pk_bg</item>
        <item name="colorSurface">@color/pk_card</item>
        <item name="colorOnSurface">@color/pk_text</item>
        <item name="colorOnBackground">@color/pk_text</item>
        <item name="android:statusBarColor">@color/pk_bg</item>
        <item name="android:navigationBarColor">@color/pk_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Pokatop" parent="Base.Theme.Pokatop" />

    <style name="TextAppearance.Pokatop.Logo" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/pk_logo</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Pokatop.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">40dp</item>
    </style>

    <style name="Widget.Pokatop.Button.Mint" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/pk_mint</item>
        <item name="android:textColor">@color/pk_on_mint</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.Pokatop.Button.Navy" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/pk_btn2_bg</item>
        <item name="android:textColor">@color/pk_btn2_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="TextAppearance.Pokatop.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/pk_text2</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Widget.Pokatop.Button.Step" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/pk_surface2</item>
        <item name="android:textColor">@color/pk_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">48dp</item>
    </style>

    <style name="TextAppearance.Pokatop.Section" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/pk_text2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ThemeOverlay.Pokatop.Toolbar" parent="">
        <item name="actionMenuTextColor">@color/pk_text</item>
        <item name="actionMenuTextAppearance">@style/TextAppearance.Pokatop.Menu</item>
    </style>

    <style name="TextAppearance.Pokatop.Menu" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
